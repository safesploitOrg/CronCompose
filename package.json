{
  "name": "croncompose",
  "version": "0.1.0-alpha.5",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:extended": "node --test tests/integration/extended.test.js",
    "lint": "node scripts/check-source.mjs",
    "check": "npm run lint && npm test",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1 --directory public"
  }
}
